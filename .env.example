# ─── Database ────────────────────────────────────────────────────────────────
DB_NAME=citizen_requests_db
DB_USER=postgres
DB_PASSWORD=changeme

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters. Change this before deploying to production.
JWT_SECRET=change-this-secret-in-production-min-32-chars!!
JWT_EXPIRATION_MS=86400000

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Leave blank to disable AI routing (requests fall back to the first department).
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite dev proxy) ────────────────────────────────────────────────
# The backend URL the Vite dev server proxies /api requests to.
VITE_API_URL=http://localhost:8080
